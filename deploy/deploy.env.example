# Configuration de la publication de l'application. Copier en deploy.env : soit ici (deploy/deploy.env), soit une
# seule fois dans le dossier parent (PackInstaller/deploy.env), partagé avec le site et l'API. Jamais versionné.
# Valeurs entre guillemets : prises telles quelles, caractères spéciaux compris.

# Publication des versions de l'application (app/deploy/deploy.py) : compte d'administration du site,
# une fois son mot de passe initial changé sur https://reflect-fivem.com/admin.
PACKS_ADMIN_USER=admin
PACKS_ADMIN_PASSWORD=""
# Même chose pour l'API de dev (option --dev).
PACKS_DEV_ADMIN_USER=admin
PACKS_DEV_ADMIN_PASSWORD=""
